[
  {
    "name": "get_customer_history",
    "description": "Return authoritative order history for one scoped customer identity.",
    "input_schema": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "customer_unique_id": {
          "title": "Customer Unique Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "customer_unique_id"
      ],
      "type": "object",
      "title": "get_customer_historyArguments"
    },
    "output_schema": {
      "properties": {
        "schema_version": {
          "const": "day09-mcp-evidence-v1",
          "default": "day09-mcp-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_ref": {
          "pattern": "^ev_[A-Za-z0-9_-]{20,96}$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "result_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Result Hash",
          "type": "string"
        },
        "domain": {
          "enum": [
            "order",
            "item",
            "payment",
            "shipment",
            "seller",
            "customer",
            "product",
            "refund",
            "policy"
          ],
          "title": "Domain",
          "type": "string"
        },
        "data": {
          "title": "Data"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "evidence_ref",
        "result_hash",
        "domain",
        "data"
      ],
      "type": "object",
      "additionalProperties": false,
      "title": "EvidenceResponse"
    }
  },
